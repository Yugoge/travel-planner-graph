          {
            "name_base": "Reunion Dinner and Spring Festival Gala (Nianye Fan + Chunwan Beijing)",
            "name_local": "年夜饭 + 春晚背景",
            "location_base": "Family Home (Banshan Yicheng A District Building 35 Unit 1902)",
