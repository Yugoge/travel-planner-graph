            "name_base": "Huanhuaxi Park (浣花溪公园)",
            "name_local": "浣花溪公园",
            "location_base": "Caotang Road, Qingyang District, Chengdu, Sichuan",
            "location_local": "四川省成都市青羊区草堂路浣花溪公园",
