          {
            "name_base": "Kuanzhai Alley Hidden Corners (宽窄巷子文艺角落)",
            "name_local": "宽窄巷子",
            "location_base": "Kuanzhai Alley, Qingyang District, Chengdu, Sichuan",
            "location_local": "四川省成都市青羊区宽窄巷子",
            "coordinates": {
              "lat": 30.663213,
