          {
            "name_base": "Jinli Ancient Street (锦里古街)",
            "name_local": "锦里古街",
            "location_base": "Adjacent to Wuhou Shrine, Wuhou District, Chengdu, Sichuan",
            "location_local": "四川省成都市武侯区锦里古街（武侯祠南门旁）",
            "coordinates": {
