            "name_local": "远洋太古里",
            "location_base": "Hongxing Middle Road 4 Section, Jinjiang District, Chengdu, Sichuan",
            "location_local": "四川省成都市锦江区红星中路四段",
            "coordinates": {
              "lat": 30.657922,
