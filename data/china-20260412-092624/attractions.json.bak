          {
            "name_base": "Prince Dai Mansion and Nine Dragon Screen (代王府九龙壁)",
            "name_local": "大同代王府",
            "location_base": "Heping Road, Ancient City Area, Datong, Shanxi",
            "location_local": "山西省大同市古城区和平路",
