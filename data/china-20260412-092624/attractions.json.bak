            "name_base": "Daci Monastery (大慈寺)",
            "name_local": "大慈寺",
            "location_base": "Hongxing Middle Road 4 Section, inside Sino-Ocean Taikoo Li, Jinjiang District, Chengdu",
            "location_local": "四川省成都市锦江区红星中路四段（远洋太古里内）",
            "coordinates": {
              "lat": 30.658194,
