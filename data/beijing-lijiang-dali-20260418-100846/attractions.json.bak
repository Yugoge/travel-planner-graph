          {
            "name_base": "Sifang Square (Evening, Lijiang Old Town)",
            "name_local": "四方街",
            "location_base": "Wuyi Road Lower Section, Dayan Town, Lijiang Old Town",
            "location_local": "丽江古城五一路下段",
            "coordinates": {
              "lat": 26.872039,
              "lng": 100.233949
            },
            "cost": 0,
            "currency_local": "CNY",
            "type_base": "Scenic Area",
            "type_local": "广场景区",
            "notes_base": "The historic heart of Lijiang Old Town — best experienced in the evening when lanterns are lit. A great gathering point for the evening stroll after the rest day wander in Shuhe. The square fills with golden lantern light at night — ideal for couple photos. Nearby: Water Street flower stalls, traditional Naxi music performances.",
            "notes_local": "丽江古城的历史中心，夜晚灯笼点亮，金光氤氲，是情侣拍照的绝佳机位。束河发呆日结束后，傍晚来四方街漫步，氛围最佳。附近有水街鲜花摊和纳西族传统音乐表演。",
            "opening_hours": "24小时开放",
            "optional": true,
            "search_results": [
