          {
            "name_base": "Xizhou Ancient Town (Bai Minority Heritage)",
            "name_local": "喜洲古镇",
            "location_base": "Qingzhen Road 130, Xizhou Town, Dali City",
            "location_local": "云南省大理市喜洲镇清真路130号",
            "coordinates": {
