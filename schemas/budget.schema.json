{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "budget.schema.json",
  "title": "Budget Agent Output",
  "description": "Schema for the budget agent output. Each day contains budget breakdowns by category (meals, accommodation, activities, shopping, transportation) and optional detailed breakdowns. Root-level fields include trip totals and overage calculations.",
  "$comment": "M2 (spec-20260508-221237): superseded by schemas/v2/budget.schema.json (in-memory snapshot returned by /api/budget/recompute; not persisted in M2). The budget agent's batch-output role is replaced by the M4 server's per-event recompute (§5.10).",
  "type": "object",
  "properties": {
    "agent": {
      "type": "string",
      "const": "budget"
    },
    "status": {
      "type": "string",
      "enum": ["complete"]
    },
    "data": {
      "type": "object",
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/day_entry"
          }
        },
        "trip_total": {
          "type": "number",
          "description": "Total trip cost."
        },
        "user_budget": {
          "type": "number",
          "description": "User's stated budget."
        },
        "overage": {
          "type": "number",
          "description": "Amount over budget (can be negative if under budget)."
        },
        "overage_percentage": {
          "type": "number",
          "description": "Percentage over budget."
        },
        "budget_assessment": {
          "type": "object",
          "description": "Free-form trip-level budget assessment payload.",
          "additionalProperties": true
        },
        "data_quality_warnings": {
          "type": "array",
          "description": "Free-form list of trip-level data-quality warnings (strings or objects).",
          "items": { "type": ["object", "string"], "additionalProperties": true }
        },
        "major_transport_costs": {
          "type": "object",
          "description": "Free-form summary of major inter-city transport costs.",
          "additionalProperties": true
        },
        "optimization_recommendations": {
          "type": "array",
          "description": "Free-form list of trip-level optimization recommendations.",
          "items": { "type": ["object", "string"], "additionalProperties": true }
        }
      },
      "required": ["days"],
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": ["agent", "status", "data"],
  "additionalProperties": false,

  "$defs": {
    "budget_categories": {
      "type": "object",
      "description": "Budget breakdown by spending category.",
      "properties": {
        "meals": {
          "type": "number",
          "description": "Total meal costs for this day."
        },
        "accommodation": {
          "type": "number",
          "description": "Accommodation cost for this day."
        },
        "activities": {
          "type": "number",
          "description": "Activities/attractions costs for this day."
        },
        "shopping": {
          "type": "number",
          "description": "Shopping costs for this day."
        },
        "transportation": {
          "type": "number",
          "description": "Transportation costs for this day."
        },
        "cafe": {
          "type": "number",
          "description": "Cafe costs for this day."
        },
        "total": {
          "type": "number",
          "description": "Total cost for this day."
        }
      },
      "required": ["meals", "accommodation", "activities", "shopping", "transportation", "cafe", "total"],
      "additionalProperties": true
    },

    "day_entry": {
      "type": "object",
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "description": "Day number in the trip (1-indexed)."
        },
        "date": {
          "type": "string",
          "description": "Date in YYYY-MM-DD format."
        },
        "location": {
          "type": "string",
          "description": "City or location for this day."
        },
        "budget": {
          "$ref": "#/$defs/budget_categories"
        },
        "breakdown": {
          "type": "object",
          "description": "Detailed breakdown of costs within each category. Freeform structure (per-day detail dict; keys vary by trip).",
          "additionalProperties": true
        },
        "notes": {
          "type": "string",
          "description": "Free-form notes about this day's budget."
        },
        "currency_local": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Optional day-level currency override (ISO 4217). Inherits from plan-level currency_local if absent."
        },
        "optimization_recommendations": {
          "type": "array",
          "description": "Free-form list of per-day optimization recommendations.",
          "items": { "type": ["object", "string"], "additionalProperties": true }
        },
        "warnings": {
          "type": "array",
          "description": "Free-form list of per-day budget warnings.",
          "items": { "type": ["object", "string"], "additionalProperties": true }
        }
      },
      "required": ["day", "budget"],
      "additionalProperties": false
    }
  }
}
