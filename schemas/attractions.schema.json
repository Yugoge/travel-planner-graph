{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attractions.schema.json",
  "title": "Attractions Agent Output",
  "description": "Schema for the attractions agent output. STRICT: no cost_eur, type_base in Title Case, coordinates {lat,lng} only.",
  "type": "object",
  "properties": {
    "agent": { "type": "string", "const": "attractions" },
    "status": { "type": "string", "enum": ["complete"] },
    "data": {
      "type": "object",
      "properties": {
        "days": { "type": "array", "items": { "$ref": "#/$defs/day_entry" } }
      },
      "required": ["days"],
      "additionalProperties": false
    },
    "notes": { "type": "string" }
  },
  "required": ["agent", "status", "data"],
  "additionalProperties": false,

  "$comment": "W8 (spec-20260513-085358 AC13): this schema intentionally rejects an `alternatives` field at the item level via additionalProperties:false. M2 (spec-20260508-221237) supersedes the deferred unification: the new options[] shape lives in schemas/v2/attractions.schema.json and is referenced by schemas/v2/day.schema.json's slot_envelope. M3 migrates the attractions agent to emit v2; until then this v1 envelope remains valid for the agent-output channel.",

  "$defs": {
    "attraction_item": {
      "type": "object",
      "properties": {
        "name_base": { "type": "string", "minLength": 1 },
        "name_local": { "type": "string" },
        "location_base": { "type": "string" },
        "location_local": { "type": "string" },
        "coordinates": { "$ref": "poi-common.schema.json#/$defs/coordinates" },
        "cost": { "$ref": "poi-common.schema.json#/$defs/cost_field" },
        "currency_local": { "$ref": "poi-common.schema.json#/$defs/currency_code" },
        "type_base": { "type": "string", "description": "Title Case category in base language (e.g., 'Historical Site', 'Theme Park')." },
        "type_local": { "type": "string", "description": "Category in local language" },
        "notes_base": { "type": "string", "description": "Notes in base language" },
        "notes_local": { "type": "string", "description": "Notes in local language" },
        "opening_hours": { "type": "string", "description": "Opening hours description" },
        "search_results": {
          "type": "array",
          "items": { "$ref": "poi-common.schema.json#/$defs/search_result" }
        },
        "optional": {
          "type": "boolean",
          "description": "Whether this attraction is optional (nice-to-have, skip if time-constrained). Default: false.",
          "default": false
        },
        "is_home": {
          "type": "boolean",
          "description": "True if this POI is at a private home (not a commercial venue). Suppresses external image lookup."
        }
      },
      "required": ["name_base", "name_local", "location_base", "location_local", "cost", "currency_local", "type_base", "optional"],
      "additionalProperties": false
    },

    "day_entry": {
      "type": "object",
      "properties": {
        "day": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "location": { "type": "string" },
        "attractions": { "type": "array", "items": { "$ref": "#/$defs/attraction_item" } }
      },
      "required": ["day", "date", "attractions"],
      "additionalProperties": false
    }
  }
}
