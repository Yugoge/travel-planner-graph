{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shopping.schema.json",
  "title": "Shopping Agent Output",
  "description": "Schema for the shopping agent output. STRICT: no legacy fields, all items require currency, time, search_results.",
  "type": "object",
  "properties": {
    "agent": { "type": "string", "const": "shopping" },
    "status": { "type": "string", "enum": ["complete"] },
    "data": {
      "type": "object",
      "properties": {
        "days": { "type": "array", "items": { "$ref": "#/$defs/day_entry" } }
      },
      "required": ["days"],
      "additionalProperties": false
    },
    "notes": { "type": "string" }
  },
  "required": ["agent", "status", "data"],
  "additionalProperties": false,

  "$comment": "W8 (spec-20260513-085358 AC13): this schema intentionally rejects an `alternatives` field at the item level via additionalProperties:false. Full primary+alternatives[] unification across meals/attractions/shopping/entertainment is deferred to M2 (see docs/feature-status.md). The binding enforcement lives in scripts/lib/save_translate.py AGENT_SCOPED_BANNED_KEYS — see _reject_agent_scoped().",

  "$defs": {
    "shopping_item": {
      "type": "object",
      "properties": {
        "name_base": { "type": "string", "minLength": 1 },
        "name_local": { "type": "string", "description": "Chinese name. Empty string '' if unknown." },
        "location_base": { "type": "string" },
        "location_local": { "type": "string", "description": "Chinese address. Empty string '' if unknown." },
        "coordinates": { "$ref": "poi-common.schema.json#/$defs/coordinates" },
        "cost": { "$ref": "poi-common.schema.json#/$defs/cost_field" },
        "currency_local": { "$ref": "poi-common.schema.json#/$defs/currency_code" },
        "type_base": { "type": "string", "description": "Shopping type in base language" },
        "type_local": { "type": "string", "description": "Shopping type in local language" },
        "notes_base": { "type": "string", "description": "Notes in base language" },
        "notes_local": { "type": "string", "description": "Notes in local language" },
        "search_results": {
          "type": "array",
          "items": { "$ref": "poi-common.schema.json#/$defs/search_result" }
        },
        "optional": {
          "type": "boolean",
          "description": "Whether this shopping is optional (flexible/skippable). Default: false.",
          "default": false
        },
        "brands": {
          "type": "array",
          "description": "Individual brand stores within this mall/shopping location. Structured alternative to encoding brands in notes_base free text (root cause: cfc5766).",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1, "description": "Brand name in base language" },
              "name_local": { "type": "string", "description": "Brand name in local language" },
              "category": { "type": "string", "description": "Brand category (e.g. DESIGNER, SPORTS, FOOD)" },
              "category_local": { "type": "string", "description": "Brand category in local language" },
              "floor": { "type": "string", "description": "Floor within the mall (e.g. 1F, B1, 3F)" },
              "description": { "type": "string", "description": "Brand description in base language" },
              "description_local": { "type": "string", "description": "Brand description in local language" }
            },
            "required": ["name", "category"],
            "additionalProperties": false
          }
        }
      },
      "required": ["name_base", "name_local", "location_base", "location_local", "cost", "currency_local", "type_base", "optional"],
      "additionalProperties": false
    },

    "day_entry": {
      "type": "object",
      "properties": {
        "day": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "location": { "type": "string" },
        "shopping": { "type": "array", "items": { "$ref": "#/$defs/shopping_item" } }
      },
      "required": ["day", "date", "shopping"],
      "additionalProperties": false
    }
  }
}
