{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cafe.schema.json",
  "title": "Cafe Agent Output",
  "description": "Schema for the cafe agent output. Covers coffee shops, teahouses, and rest/relaxation spots. Array-based structure (not meal-slot). STRICT: coordinates {lat,lng} only, currency required, type_base required.",
  "$comment": "M2 (spec-20260508-221237): superseded by schemas/v2/cafe.schema.json (options[] inside slot_envelope). M3 migrates the cafe agent to emit v2.",
  "type": "object",
  "properties": {
    "agent": { "type": "string", "const": "cafe" },
    "status": { "type": "string", "enum": ["complete"] },
    "data": {
      "type": "object",
      "properties": {
        "days": { "type": "array", "items": { "$ref": "#/$defs/day_entry" } }
      },
      "required": ["days"],
      "additionalProperties": false
    },
    "notes": { "type": "string" }
  },
  "required": ["agent", "status", "data"],
  "additionalProperties": false,

  "$defs": {
    "cafe_item": {
      "type": "object",
      "properties": {
        "name_base": { "type": "string", "minLength": 1 },
        "name_local": { "type": "string" },
        "location_base": { "type": "string" },
        "location_local": { "type": "string" },
        "coordinates": { "$ref": "poi-common.schema.json#/$defs/coordinates" },
        "cost": { "$ref": "poi-common.schema.json#/$defs/cost_field" },
        "currency_local": { "$ref": "poi-common.schema.json#/$defs/currency_code" },
        "type_base": { "type": "string", "description": "Cafe type in base language (e.g. Coffee Shop, Teahouse, Rest Spot, Bakery Cafe)" },
        "type_local": { "type": "string", "description": "Cafe type in local language" },
        "cuisine_base": { "type": "string", "description": "Cuisine/specialty type in base language" },
        "cuisine_local": { "type": "string", "description": "Cuisine/specialty type in local language" },
        "signature_dishes_base": { "type": "string", "description": "Signature items in base language" },
        "signature_dishes_local": { "type": "string", "description": "Signature items in local language" },
        "notes_base": { "type": "string", "description": "Notes in base language" },
        "notes_local": { "type": "string", "description": "Notes in local language" },
        "search_results": {
          "type": "array",
          "items": { "$ref": "poi-common.schema.json#/$defs/search_result" }
        },
        "optional": {
          "type": "boolean",
          "description": "Whether this cafe visit is optional (flexible/skippable). Default: false.",
          "default": false
        },
        "is_home": {
          "type": "boolean",
          "description": "True if this POI is at a private home (not a commercial venue). Suppresses external image lookup."
        }
      },
      "required": ["name_base", "name_local", "location_base", "location_local", "cost", "currency_local", "type_base", "optional"],
      "additionalProperties": false
    },

    "day_entry": {
      "type": "object",
      "properties": {
        "day": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "location": { "type": "string" },
        "cafe": { "type": "array", "items": { "$ref": "#/$defs/cafe_item" } }
      },
      "required": ["day", "date", "cafe"],
      "additionalProperties": false
    }
  }
}
