{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planner/schemas/v2/accommodation.schema.json",
  "title": "M2 v2 Accommodation Option",
  "description": "Per-night-accommodation option. Composes option_base via allOf. Note: accommodation slot is orthogonal to the 6 named time-slots (§5.8); a day always has exactly one accommodation slot, and same-city continuation auto-locks to the prior day's selection (§5.7 B).",
  "allOf": [
    {"$ref": "poi-common.schema.json#/$defs/option_base"},
    {
      "type": "object",
      "properties": {
        "accommodation_type": {
          "type": "string",
          "description": "e.g. 'boutique-hotel', 'hostel', 'family-stay', 'apartment'."
        },
        "amenities": {"type": "array", "items": {"type": "string"}},
        "stars": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 5
        },
        "check_in": {"type": "string", "description": "HH:MM local; soft-anchor only."},
        "check_out": {"type": "string"},
        "notes": {"type": "string"},
        "notes_local": {"type": "string"}
      }
    }
  ]
}
