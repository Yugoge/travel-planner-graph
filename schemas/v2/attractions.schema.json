{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planner/schemas/v2/attractions.schema.json",
  "title": "M2 v2 Attraction Option",
  "description": "Per-attraction option for morning_activity/afternoon_activity/evening_activity slots. Composes option_base via allOf.",
  "allOf": [
    {"$ref": "poi-common.schema.json#/$defs/option_base"},
    {
      "type": "object",
      "properties": {
        "attraction_type": {"type": "string", "description": "Title-Case category, e.g. 'Historical Site', 'Theme Park'."},
        "attraction_type_local": {"type": "string"},
        "opening_hours": {"type": "string"},
        "estimated_duration_min": {
          "type": "number",
          "minimum": 0,
          "description": "Suggested visit duration in minutes; consumed by timeline planner."
        },
        "notes": {"type": "string"},
        "notes_local": {"type": "string"}
      }
    }
  ]
}
