{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planner/schemas/v2/entertainment.schema.json",
  "title": "M2 v2 Entertainment Option",
  "description": "Per-entertainment option for evening_activity slot (live shows, bars, nightlife). Composes option_base via allOf.",
  "allOf": [
    {"$ref": "poi-common.schema.json#/$defs/option_base"},
    {
      "type": "object",
      "properties": {
        "entertainment_type": {"type": "string"},
        "entertainment_type_local": {"type": "string"},
        "opening_hours": {"type": "string"},
        "notes": {"type": "string"},
        "notes_local": {"type": "string"}
      }
    }
  ]
}
