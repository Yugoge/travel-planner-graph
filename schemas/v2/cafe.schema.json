{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planner/schemas/v2/cafe.schema.json",
  "title": "M2 v2 Cafe Option",
  "description": "Per-cafe option for activity slots (rest stops, coffee, teahouses). Composes option_base via allOf.",
  "allOf": [
    {"$ref": "poi-common.schema.json#/$defs/option_base"},
    {
      "type": "object",
      "properties": {
        "cafe_type": {"type": "string", "description": "e.g. 'coffee-shop', 'teahouse', 'bakery-cafe', 'rest-spot'."},
        "specialty": {"type": "string"},
        "specialty_local": {"type": "string"},
        "notes": {"type": "string"},
        "notes_local": {"type": "string"}
      }
    }
  ]
}
