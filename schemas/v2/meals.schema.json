{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planner/schemas/v2/meals.schema.json",
  "title": "M2 v2 Meal Option",
  "description": "Per-meal-option category schema. Composes option_base via allOf and adds meal-specific fields. Used inside slot.options[] for breakfast/lunch/dinner slots.",
  "allOf": [
    {"$ref": "poi-common.schema.json#/$defs/option_base"},
    {
      "type": "object",
      "properties": {
        "cuisine": {"type": "string", "description": "Cuisine type label (e.g. 'sichuanese', 'noodles')."},
        "cuisine_local": {"type": "string"},
        "signature_dishes": {"type": "string"},
        "signature_dishes_local": {"type": "string"},
        "meal_kind": {
          "type": "string",
          "enum": ["breakfast", "lunch", "dinner"],
          "description": "Which meal slot this option targets; must match parent slot.slot_id."
        },
        "notes": {"type": "string"},
        "notes_local": {"type": "string"}
      }
    }
  ]
}
