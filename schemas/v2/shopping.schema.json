{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planner/schemas/v2/shopping.schema.json",
  "title": "M2 v2 Shopping Option",
  "description": "Per-shopping option for activity slots (markets, malls, boutiques). Composes option_base via allOf.",
  "allOf": [
    {"$ref": "poi-common.schema.json#/$defs/option_base"},
    {
      "type": "object",
      "properties": {
        "shopping_type": {"type": "string"},
        "shopping_type_local": {"type": "string"},
        "brands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "name_local": {"type": "string"},
              "category": {"type": "string"},
              "floor": {"type": "string"}
            },
            "required": ["name"],
            "additionalProperties": true
          }
        },
        "notes": {"type": "string"},
        "notes_local": {"type": "string"}
      }
    }
  ]
}
