# P1.5-3: Sec-CH-UA Client Hints aligned with UA + navigator.userAgentData override
#
# Scope (ONE issue): Add sec-ch-ua, sec-ch-ua-platform, sec-ch-ua-mobile headers
# to extraHTTPHeaders (authManager.js, hunk 1) AND override
# navigator.userAgentData.getHighEntropyValues() to return matching macOS /
# Chrome 145 values (rednoteTools.js addInitScript, hunk 2). Without this, the
# browser advertises a macOS UA in the string but a Linux CH-UA in the headers
# and high-entropy API -- a trivial mismatch for bot detectors.
#
# Anchor:
#   Hunk 1: P0-1 output state of authManager.js. Before this patch, the
#   newContext({... extraHTTPHeaders: { 'accept-language': ... } ...}) block
#   has 1 header. This hunk expands it to 4 headers by inserting 3 new keys
#   after the existing accept-language line, before the closing `},` of
#   extraHTTPHeaders.
#
#   Hunk 2: post-P1.5-2 output state of rednoteTools.js. Stacks like other
#   P1.5-N rednoteTools hunks (inserts new try/catch before the `});` closing
#   addInitScript and the `await this.page.route('**://edith.xiaohongshu.com/**'`
#   line that follows it).
#
# Red lines: No fetch/XHR/cookie overrides. No Origin/Referer override
# (LESSONS §"DO NOT override Origin/Referer for edith"). The `brands` array
# order matches real Chrome 145 GREASE (Chromium middle, "Not=A?Brand" decoy).
#
--- a/usr/lib/node_modules/rednote-mcp/dist/auth/authManager.js
+++ b/usr/lib/node_modules/rednote-mcp/dist/auth/authManager.js
@@ -124,6 +124,9 @@
                     timezoneId: 'Asia/Shanghai',
                     extraHTTPHeaders: {
                         'accept-language': 'zh-CN,zh;q=0.9',
+                        'sec-ch-ua': '"Chromium";v="145", "Not=A?Brand";v="99", "Google Chrome";v="145"',
+                        'sec-ch-ua-mobile': '?0',
+                        'sec-ch-ua-platform': '"macOS"',
                     },
                 });
                 this.page = await this.context.newPage();
