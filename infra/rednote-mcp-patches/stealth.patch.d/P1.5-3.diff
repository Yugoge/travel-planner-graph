+                    // P1.5-3: navigator.userAgentData.getHighEntropyValues() override -- aligned with Sec-CH-UA headers (Chrome 145 macOS)
+                    if (navigator.userAgentData && navigator.userAgentData.getHighEntropyValues) {
+                        const brands = [
+                            { brand: 'Chromium',       version: '145' },
+                            { brand: 'Not=A?Brand',    version: '99'  },
+                            { brand: 'Google Chrome',  version: '145' }
+                        ];
+                        const fullValueMap = {
+                            brands: brands,
+                            mobile: false,
+                            platform: 'macOS',
+                            architecture: 'arm',
+                            bitness: '64',
+                            model: '',
+                            platformVersion: '15.0.0',
+                            uaFullVersion: '145.0.0.0',
+                            fullVersionList: brands.map(b => ({ brand: b.brand, version: b.version + '.0.0.0' })),
+                            wow64: false
+                        };
+                        navigator.userAgentData.getHighEntropyValues = function (hints) {
+                            const out = {};
+                            (hints || []).forEach(h => { if (h in fullValueMap) out[h] = fullValueMap[h]; });
+                            return Promise.resolve(out);
+                        };
+                        Object.defineProperty(navigator.userAgentData, 'brands',   { get: () => brands,  configurable: true });
