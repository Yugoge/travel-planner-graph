+    /**
+     * Sample from a Weibull distribution using inverse-CDF method.
+     * Provides heavy-tail, right-skewed delays that mirror real human action timing
+     * (occasional long pauses, clustered short bursts). See spec view dev.md §8.
+     * @param shape Weibull shape parameter k (>1 => peaked, heavy tail rightward)
+     * @param scale Weibull scale parameter lambda in seconds
+     * @returns sampled delay in seconds
+     */
+    _weibullSample(shape, scale) {
+        const u = Math.random();
+        // Guard against u=0 which would give log(1)=0 then pow(0, 1/k)=0 — still valid, but
+        // guard against u=1 edge which would produce Infinity.
+        const uSafe = u >= 1 ? 0.999999 : u;
+        return scale * Math.pow(-Math.log(1 - uSafe), 1 / shape);
+    }
