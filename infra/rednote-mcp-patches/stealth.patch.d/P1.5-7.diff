+                try {
+                    // P1.5-7: navigator.getBattery() -- per-session randomized {charging, level}; stable during session
+                    const battCharging = Math.random() < 0.5;
+                    const battLevel = Math.round((0.3 + Math.random() * 0.65) * 100) / 100; // [0.30, 0.95]
+                    const fakeBattery = {
+                        charging: battCharging,
+                        chargingTime: battCharging ? 0 : Infinity,
+                        dischargingTime: battCharging ? Infinity : Math.round(3600 + Math.random() * 18000),
+                        level: battLevel,
+                        addEventListener: function () {},
+                        removeEventListener: function () {},
+                        dispatchEvent: function () { return true; }
+                    };
+                    navigator.getBattery = function () { return Promise.resolve(fakeBattery); };
+                } catch (e) {}
             });
