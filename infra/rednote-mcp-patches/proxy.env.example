# IPRoyal per-session proxy config for rednote-mcp (P1.5-14)
#
# USAGE:
#   1. Copy this file to /root/.mcp/rednote/proxy.env
#   2. chmod 600 /root/.mcp/rednote/proxy.env
#   3. Replace ALL placeholders (<YOUR_*>) with real values from your
#      IPRoyal dashboard (https://dashboard.iproyal.com/)
#   4. Replace <YOUR_8HEX> with a unique 8-hex session id (e.g. a1b2c3d4)
#   5. DO NOT commit the real proxy.env to git (contains credentials)
#   6. To disable proxy (direct VPS connection), leave REDNOTE_PROXY_URL empty
#
# FIELDS in REDNOTE_PROXY_PASS:
#   <YOUR_IPROYAL_PASSWORD>    -> IPRoyal base password from dashboard
#   country-fr                 -> France exit IP (user's account is from France;
#                                 country-cn would trigger 异地登录 alarm)
#   city-paris                 -> Paris city pin (stable exit cluster)
#   session-rednote-<YOUR_8HEX>-> UNIQUE session id isolated from happy-server
#                                 sessions (prevents IP pollution & cross-account
#                                 linkage). Replace <YOUR_8HEX> with e.g. a1b2c3d4
#   lifetime-168h              -> 7-day sticky session
#   streaming-1                -> Streaming endpoint (required for Playwright)
#
# Local GOST endpoints (existing infra - read-only from dev):
#   http://127.0.0.1:8080   -> HTTP forward proxy
#   socks5://127.0.0.1:1080 -> SOCKS5 forward proxy

REDNOTE_PROXY_URL=http://127.0.0.1:8080
REDNOTE_PROXY_USER=<YOUR_IPROYAL_USERNAME>
REDNOTE_PROXY_PASS=<YOUR_IPROYAL_PASSWORD>_country-fr_city-paris_session-rednote-<YOUR_8HEX>_lifetime-168h_streaming-1
